; Test that the -enable-multi-instr-patterns flag controls multi-instruction
; pattern matching in known bits analysis.

; Test 1: Inverted mask pattern (X & ~M) + (Y & M)
; With multi-instr patterns enabled, add is converted to disjoint or.
; With multi-instr patterns disabled, add remains add.
define i32 @test_inverted_mask(i32 noundef %x, i32 noundef %y, i32 noundef %m) {
; ENABLED-LABEL: @test_inverted_mask(
; ENABLED-NEXT:    [[X:%.*]] = xor i32 [[Y:%.*]], -1
; ENABLED-NEXT:    [[A:%.*]] = and i32 [[NOTM:%.*]], [[X]]
; ENABLED-NEXT:    [[B:%.*]] = and i32 [[M:%.*]], [[Y]]
; ENABLED-NEXT:    [[ADD:%.*]] = or disjoint i32 [[A]], [[B]]
; ENABLED-NEXT:    ret i32 [[ADD]]
;
; DISABLED-LABEL: @test_inverted_mask(
; DISABLED-NEXT:    [[X:%.*]] = xor i32 [[Y:%.*]], -1
; DISABLED-NEXT:    [[A:%.*]] = and i32 [[NOTM:%.*]], [[X]]
; DISABLED-NEXT:    [[B:%.*]] = and i32 [[M:%.*]], [[Y]]
; DISABLED-NEXT:    [[ADD:%.*]] = add i32 [[A]], [[B]]
; DISABLED-NEXT:    ret i32 [[ADD]]
;
  %notm = xor i32 %m, -1
  %a = and i32 %x, %notm
  %b = and i32 %y, %m
  %add = add i32 %a, %b
  ret i32 %add
}

