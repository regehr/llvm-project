; ENABLED-NEXT:    [[ADD:%.*]] = or i32 [[X:%.*]], [[Y:%.*]]
; ENABLED-NEXT:    ret i32 [[ADD]]
;
; DISABLED-LABEL: @test_x_and_not_x(
