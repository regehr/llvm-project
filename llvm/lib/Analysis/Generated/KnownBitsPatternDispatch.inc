}

static std::optional<KnownBits> computePatternKB(const Operator *I, const SimplifyQuery &Q, unsigned Depth) {
  std::optional<KnownBits> Acc;
  switch (classifyPatternOp(I, Q)) {
  case PatternOp::Add:
    mergePatternKB(Acc, match003(I, Q, Depth + 1));
    mergePatternKB(Acc, match020(I, Q, Depth + 1));
    mergePatternKB(Acc, match022(I, Q, Depth + 1));
    mergePatternKB(Acc, match025(I, Q, Depth + 1));
    mergePatternKB(Acc, match026(I, Q, Depth + 1));
    break;
  case PatternOp::AddNsw:
    mergePatternKB(Acc, match008(I, Q, Depth + 1));
    mergePatternKB(Acc, match019(I, Q, Depth + 1));
    mergePatternKB(Acc, match037(I, Q, Depth + 1));
    mergePatternKB(Acc, match038(I, Q, Depth + 1));
    break;
  case PatternOp::AddNswNuw:
    mergePatternKB(Acc, match034(I, Q, Depth + 1));
    mergePatternKB(Acc, match046(I, Q, Depth + 1));
    mergePatternKB(Acc, match050(I, Q, Depth + 1));
    break;
  case PatternOp::And:
    mergePatternKB(Acc, match013(I, Q, Depth + 1));
    mergePatternKB(Acc, match045(I, Q, Depth + 1));
    break;
  case PatternOp::AshrExact:
    mergePatternKB(Acc, match004(I, Q, Depth + 1));
    break;
  case PatternOp::Lshr:
    mergePatternKB(Acc, match027(I, Q, Depth + 1));
    mergePatternKB(Acc, match032(I, Q, Depth + 1));
    break;
  case PatternOp::OrDisjoint:
    mergePatternKB(Acc, match014(I, Q, Depth + 1));
    mergePatternKB(Acc, match018(I, Q, Depth + 1));
    break;
  case PatternOp::SdivExact:
    mergePatternKB(Acc, match012(I, Q, Depth + 1));
    break;
  case PatternOp::Sub:
    mergePatternKB(Acc, match047(I, Q, Depth + 1));
    break;
  default:
    break;
  }
  return Acc;
}
