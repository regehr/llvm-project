  const bool Matched = matchEitherRootOrder(CanMatchFwd, CanMatchRev, RootL, RootR, matchRootOrder, Arg0, Arg1, Arg2);
  if (!Matched) return std::nullopt;
  LLVM_DEBUG(dbgs() << "[KnownBits DAG] matched pattern 050 on: " << *I << "\n");
