  auto ArrArg1 = kbToArr(computeKnownBits(Arg1, Q, Depth));
  auto ArrArg2 = kbToArr(computeKnownBits(Arg2, Q, Depth));
  return arrToKB(Pattern038::solution(ArrArg0, ArrArg1, ArrArg2));
}

