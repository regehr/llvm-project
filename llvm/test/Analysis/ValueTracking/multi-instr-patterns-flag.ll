; Test 3: (A & B) + ~(A | B) pattern
; With multi-instr patterns enabled, add is converted to disjoint or.
; With multi-instr patterns disabled, add remains add.
define i32 @test_and_not_or(i32 noundef %a, i32 noundef %b) {
; ENABLED-LABEL: @test_and_not_or(
; ENABLED-NEXT:    [[OR:%.*]] = xor i32 [[A:%.*]], [[B:%.*]]
; ENABLED-NEXT:    [[NOTOR:%.*]] = xor i32 [[OR]], -1
; ENABLED-NEXT:    ret i32 [[NOTOR]]
